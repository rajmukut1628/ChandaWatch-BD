NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
# Empty only in development: persistent local MongoDB is launched automatically.
MONGODB_URI=
# Generate each with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=
AUDIT_KEY=
REPORTING_ENABLED=true
PUBLIC_LAUNCH_APPROVED=false
STATISTICS_MIN_COUNT=3
RETENTION_DAYS=180
# quarantine blocks downloads until a clean ClamAV result; use clamav for scanning.
SCANNER_MODE=quarantine
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
BACKUP_ENCRYPTION_KEY=
BACKUP_SCHEDULE_ENABLED=true
RETENTION_SCHEDULE_ENABLED=true
# SMTP credentials belong in this private environment file / hosting secret manager.
# STARTTLS is required on port 587. For implicit TLS on port 465 set SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
